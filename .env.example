# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the running TaskFlow application.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Optional HMAC secret for signing TaskFlow session tokens.
SESSION_SECRET="replace-with-strong-random-secret"

# PostgreSQL Connection (Cloud SQL or local PostgreSQL)
SQL_HOST="127.0.0.1"
SQL_PORT="5432"
SQL_USER="postgres"
SQL_PASSWORD="replace-with-db-password"
SQL_DATABASE="taskflow"

# Optional GitLab REST API Integration (leave blank to use Markdown export fallback)
GITLAB_BASE_URL="https://gitlab.com"
GITLAB_PROJECT_ID=""
GITLAB_TOKEN=""
